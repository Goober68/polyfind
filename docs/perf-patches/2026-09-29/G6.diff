+# ------------------------------------------------------------------ the chain-pair table build
+# The build kernel is written against the array module (``lattice_table._build_block(..., xp)``),
+# so a table can be built on the device.  It cannot be bit-identical to the CPU table -- a
+# device reduction associates the float32 plane sums differently -- so these compare to a
+# float32 tolerance, and also against the exact float64 kernel so that the check does not
+# depend on which of the two builds is taken as the reference.  None of this has run here:
+# the container has no CUDA device, and the tests are skipped.
+_TAB_KW = dict(n_angle=24, n_z=8, dr=0.25)  # ~40 radii, a few seconds on the CPU
+
+
+def _table_pair(chain, **kw):
+    from polyfind.lattice_table import PairTable
+
+    cpu = PairTable.build(chain, device="cpu", n_procs=1, **kw)
+    gpu = PairTable.build(chain, device="cuda", **kw)
+    return cpu, gpu
+
+
+def _assert_tables_agree(cpu, gpu, tol=2e-3):
+    """Entries below the cap within ``tol`` kcal/mol; capped entries capped on both."""
+    Wc, Wg = cpu.W.astype(np.float64), gpu.W.astype(np.float64)
+    assert Wg.shape == Wc.shape and gpu.W.dtype == np.float32
+    below = Wc < cpu.cap - tol
+    d = np.abs(Wg[below] - Wc[below])
+    assert d.max() < tol, f"max deviation below the cap {d.max():.2e}"
+    assert (Wg[~below] >= cpu.cap - tol).all()
+    assert (Wg <= cpu.cap + 1e-6).all()
+    assert np.allclose(np.asarray(gpu.e_intra, dtype=float), np.asarray(cpu.e_intra, dtype=float), rtol=1e-4, atol=1e-3)
+
+
+def test_table_build_default_device_follows_the_backend(cuda_backend):
+    from polyfind import lattice_table as lt
+
+    assert lt._resolve_device(None)[0] == "cuda"
+    assert lt._resolve_device("cpu")[1] is np
+    assert lt._resolve_device("cuda")[1].__name__ == "cupy"
+
+
+@pytest.mark.parametrize("symmetry", [True, False])
+def test_table_built_on_gpu_matches_cpu(cuda_backend, symmetry):
+    from polyfind.pack import periodic_chain
+    from polyfind.polymers import PVDF, THREE_STATE
+
+    ch = periodic_chain(PVDF, [0, 1, 0, 2], THREE_STATE)  # alpha-PVDF: chiral repeat, both flips differ
+    cpu, gpu = _table_pair(ch, symmetry=symmetry, **_TAB_KW)
+    _assert_tables_agree(cpu, gpu)
+
