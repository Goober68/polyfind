+def _plane_chunks(edges, batch):
+    """Split the terms of one radius, sorted by dz plane, into kernel calls.
+
+    Yields ``(lo, hi, segments)``: the term range of the call and, inside it, the
+    ``(j, lo_j, hi_j)`` plane segments it covers (indices relative to ``lo``).  A plane
+    with more than ``batch`` terms is cut into calls of ``batch``, exactly as the
+    one-plane-per-call loop this replaces did; a call otherwise takes whole planes while
+    the total fits in ``batch``.  Each plane's sum is still a reduction over the same
+    slices of the same elementwise values in the same order, so at the CPU chunk the
+    table is bit-identical to the previous builder's (measured, PE / alpha / gamma
+    on the screen grid).  What the chunk size *does* fix is the float32 association of
+    each plane sum (:data:`BUILD_CHUNK_ELEMS` says so): a NumPy build at the CUDA chunk
+    of 10^7 elements, which takes all the planes of a radius in one call, differs from
+    the default one by ~1e-4 kcal/mol in the last bits, and so will a device build.
+    """
+    nz = len(edges) - 1
+    lo, segs = None, []
+    for j in range(nz):
+        lo_j, hi_j = int(edges[j]), int(edges[j + 1])
+        if hi_j <= lo_j:
+            continue
+        if hi_j - lo_j > batch:
+            if segs:
+                yield lo, segs[-1][2] + lo, segs
+                lo, segs = None, []
+            for s in range(lo_j, hi_j, batch):
