+def test_grid_kernel_is_the_pair_potential_of_the_packer():
+    """The factored kernel (what cupy.fuse would trace) against the direct pair potential on
+    random geometry: same LJ + DSF numbers, to float32."""
+    chain = _chain(PE_T)
+    pk1 = CrystalPacker(chain, n_chains=1)
+    spec = lt._build_spec(chain, 8.0, 0.2, 1.0, 3.0, 0.1, 12, 4, 50.0, lt.BUILD_CHUNK_ELEMS, True, np.float32)
+    kernel = lt._grid_kernel(spec["rc"], spec["alpha"], spec["dsf_shift"], spec["dsf_force"], np.float32, np)
+    rng = np.random.default_rng(9)
+    m, na = 5, 12
+    f32 = np.float32
+    ang = (2 * np.pi * np.arange(na) / na).astype(f32)
+    pp, pq = rng.uniform(-np.pi, np.pi, m).astype(f32), rng.uniform(-np.pi, np.pi, m).astype(f32)
+    rp, rq = rng.uniform(0.3, 2.0, m).astype(f32), rng.uniform(0.3, 2.0, m).astype(f32)
+    zz = rng.uniform(-3, 3, m).astype(f32)
+    rd = f32(5.5)
+    cu, su = np.cos(pp[:, None] + ang), np.sin(pp[:, None] + ang)
+    cv, sv = np.cos(pq[:, None] + ang), np.sin(pq[:, None] + ang)
+    ea = rp[:, None] ** 2 + rq[:, None] ** 2 + rd * rd + zz[:, None] ** 2 - 2 * rd * rp[:, None] * cu
+    eb = 2 * rd * rq[:, None] * cv
+    pref = (-2 * rp * rq)[:, None, None]
+    P, Q = rng.integers(0, chain.n_atoms, m), rng.integers(0, chain.n_atoms, m)
+    pot = [np.asarray(a)[P, Q].astype(f32)[:, None, None] for a in (pk1.lj_x ** 6, pk1.lj_d, pk1.qq, pk1.lj_shift)]
+    v = kernel(cu[:, :, None], su[:, :, None], cv[:, None, :], sv[:, None, :], ea[:, :, None], eb[:, None, :], pref, *pot)
+    # the same geometry, explicitly: atom p at (rp, pp + a1, 0), atom q at (rd + rq cos(pq + a2), rq sin(pq + a2), zz)
+    a1, a2 = np.meshgrid(ang, ang, indexing="ij")
+    ref = np.empty_like(v, dtype=float)
+    for i in range(m):
+        xp_, yp_ = rp[i] * np.cos(pp[i] + a1), rp[i] * np.sin(pp[i] + a1)
+        xq_, yq_ = rd + rq[i] * np.cos(pq[i] + a2), rq[i] * np.sin(pq[i] + a2)
+        r2 = (xp_ - xq_) ** 2 + (yp_ - yq_) ** 2 + float(zz[i]) ** 2
+        lj_x, lj_d, qq, sh = (float(np.asarray(a)[P[i], Q[i]]) for a in (pk1.lj_x, pk1.lj_d, pk1.qq, pk1.lj_shift))
+        rr = np.sqrt(np.maximum(r2, 2.5e-3))
+        s6 = (lj_x / rr) ** 6
+        e = lj_d * (s6 * s6 - 2 * s6) - sh + qq * (lt.erfc_approx(0.2 * rr) / rr - pk1.dsf_shift + pk1.dsf_force * (rr - pk1.rc))
+        ref[i] = np.where(r2 < pk1.rc ** 2, e, 0.0)
+    ok = np.abs(ref) < 1e3
+    assert ok.sum() > 100
+    assert np.abs(v[ok] - ref[ok]).max() < 1e-3 * np.maximum(1.0, np.abs(ref[ok])).max()
