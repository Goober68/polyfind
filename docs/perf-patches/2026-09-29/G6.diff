+def test_plane_chunks_cover_every_term_of_every_plane_exactly_once():
+    rng = np.random.default_rng(3)
+    for _ in range(200):
+        nz = int(rng.integers(1, 9))
+        counts = rng.integers(0, 12, nz)
+        counts[rng.random(nz) < 0.3] = 0
+        edges = np.concatenate([[0], np.cumsum(counts)])
+        batch = int(rng.integers(1, 20))
+        seen = {j: [] for j in range(nz)}
+        for lo, hi, segs in lt._plane_chunks(edges, batch):
+            assert 0 <= lo < hi <= edges[-1]
+            assert hi - lo <= batch or len(segs) == 1  # only a single oversized plane exceeds the batch
+            assert segs[0][1] == 0 and segs[-1][2] == hi - lo
+            for j, a, b in segs:
+                assert 0 <= a < b <= hi - lo
+                seen[j].extend(range(lo + a, lo + b))
+        for j in range(nz):
+            assert seen[j] == list(range(int(edges[j]), int(edges[j + 1]))), (edges, batch, j)
+
