+def test_build_at_the_cuda_chunk_on_numpy_agrees_to_rounding():
+    """The device chunk takes every plane of a radius in one call.  On NumPy that is the
+    same arithmetic in a different float32 association: last bits only (the CPU chunk's
+    table is the bit-reproducible one; ``BUILD_CHUNK_ELEMS`` documents the trade)."""
+    chain = _chain(PVDF_A)
+    kw = dict(n_angle=24, n_z=4, dr=0.4)
+    ref = PairTable.build(chain, n_procs=1, device="cpu", **kw)
+    big = PairTable.build(chain, n_procs=1, device="cpu", chunk_elems=lt.BUILD_CHUNK_ELEMS_CUDA, **kw)
+    assert big.W.shape == ref.W.shape
+    d = np.abs(big.W.astype(float) - ref.W)
+    assert d.max() < 1e-3, f"max deviation {d.max():.2e}"
+    assert (d > 0).any() or np.array_equal(big.W, ref.W)
+
