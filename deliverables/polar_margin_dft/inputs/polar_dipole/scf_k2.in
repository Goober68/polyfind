&CONTROL
  calculation = 'scf'
  prefix = 'pvdf_polar_dipole'
  pseudo_dir = '/home/niall_sweeny/polar_margin/pseudo'
  outdir = '/home/niall_sweeny/polar_margin/scratch/polar_dipole_scf_k2'
  tstress = .true.
  tprnfor = .true.
  disk_io = 'low'
/

&SYSTEM
  ibrav = 0
  nat = 12
  ntyp = 3
  input_dft = 'PBE'
  occupations = 'fixed'
  ecutwfc = 90
  ecutrho = 360
  vdw_corr = 'grimme-d3'
  dftd3_version = 4
  dftd3_threebody = .false.
/

&ELECTRONS
  conv_thr = 1.0d-11
  electron_maxstep = 200
  mixing_mode = 'plain'
  mixing_beta = 0.3
  startingwfc = 'atomic+random'
/

