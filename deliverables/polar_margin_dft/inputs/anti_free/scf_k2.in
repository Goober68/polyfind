&CONTROL
  calculation = 'scf'
  prefix = 'pvdf_anti_free'
  pseudo_dir = '/home/niall_sweeny/polar_margin/pseudo'
  outdir = '/home/niall_sweeny/polar_margin/scratch/anti_free_scf_k2'
  tstress = .true.
  tprnfor = .true.
  disk_io = 'low'
/

&SYSTEM
  ibrav = 0
  nat = 12
  ntyp = 3
  input_dft = 'PBE'
  occupations = 'fixed'
  ecutwfc = 90
  ecutrho = 360
  vdw_corr = 'grimme-d3'
