&CONTROL
  calculation = 'vc-relax'
  prefix = 'pvdf_anti_free'
  pseudo_dir = '/home/niall_sweeny/polar_margin/pseudo'
  outdir = '/home/niall_sweeny/polar_margin/scratch/anti_free_relax_nosym'
  tstress = .true.
  tprnfor = .true.
  disk_io = 'low'
  etot_conv_thr = 1.0d-6
  forc_conv_thr = 1.0d-4
  nstep = 300
/

&SYSTEM
  ibrav = 0
  nat = 12
  ntyp = 3
  input_dft = 'PBE'
  occupations = 'fixed'
  ecutwfc = 90
  ecutrho = 360
  vdw_corr = 'grimme-d3'
  dftd3_version = 4
  dftd3_threebody = .false.
  nosym = .true.
/

&ELECTRONS
  conv_thr = 1.0d-10
  electron_maxstep = 200
  mixing_mode = 'plain'
  mixing_beta = 0.3
  startingwfc = 'atomic+random'
/

&IONS
  ion_dynamics = 'bfgs'
/

&CELL
  cell_dynamics = 'bfgs'
  press = 0.0
  press_conv_thr = 0.5
  cell_dofree = 'all'
/

ATOMIC_SPECIES
H 1.00794 H_ONCV_PBE-1.0.oncvpsp.upf
C 12.0107 C.pbe-n-kjpaw_psl.1.0.0.UPF
F 18.998403163 F.oncvpsp.upf

